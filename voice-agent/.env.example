LIVEKIT_URL=YOUR_LIVEKIT_URL
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET

GROQ_API_KEY=YOUR_GROQ_API_KEY

# Optional. These are the defaults, override only if you want to.
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah

# The Node order-to-cash server Friday calls for orders, invoices and the
# collections summary. Start it first: `npm start` from the repo root.
ORDER_TO_CASH_API_URL=http://localhost:3000

# Optional. Only needed if VOICE_AGENT_API_KEY is set in the Node server's
# .env — then this must match it, or every tool call gets a 401.
VOICE_AGENT_API_KEY=
