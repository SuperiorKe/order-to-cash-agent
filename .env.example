# Copy to .env and fill in. The server boots without any of these (dry-run mode),
# so you can develop routes before credentials arrive.

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
BUSINESS_NAME=Acme Fabricators
CURRENCY=KES

# --- Africa's Talking ---
AT_USERNAME=sandbox
AT_API_KEY=
AT_SMS_SHORTCODE=
AT_VOICE_NUMBER=
AT_USSD_SERVICE_CODE=
# The AT sandbox intermittently rejects a valid key with a 401. Measured on
# 27 Aug 2026 at roughly 40% of single attempts. These control the retry that
# absorbs it. Lower them once you are on a live account.
AT_SEND_ATTEMPTS=5
AT_SEND_GAP_MS=3000

# --- M-Pesa Daraja ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=

# --- LLM (agent brain, via OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# --- Core ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/order_to_cash

# --- Collections cadence (keep minutes low for the demo) ---
DEFAULT_PAYMENT_TERMS_DAYS=7
REMINDER_GAP_MINUTES=2
OWNER_GAP_MINUTES=6
OWNER_PHONE=
AGENT_TICK_CRON=*/1 * * * *
